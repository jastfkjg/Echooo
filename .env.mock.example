# Local product demo: real persistence/authorization, deterministic text replies.
# Browser speech is optional. Mock STT does not transcribe microphone audio.
STT_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=browser
DATABASE_URL=sqlite:///data/echooo.db
APP_HOST=127.0.0.1
APP_PORT=8000
PUBLIC_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=false
LOG_LEVEL=INFO
