# Server-only settings. Start with mock providers for the first smoke test.
STT_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=browser
LOG_LEVEL=INFO
# For live providers, copy the relevant settings from the root .env.example.
# Container localhost is the container itself, not the cloud server.
# STT_PROVIDER=assemblyai
# ASSEMBLYAI_API_KEY=
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_MODEL=
# LLM_API_KEY=
