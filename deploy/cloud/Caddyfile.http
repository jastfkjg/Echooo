http://{$DOMAIN} {
    # Owner creation is available only through the server-side CLI.
    @setup path /api/auth/setup /api/auth/setup/*
    respond @setup "Owner setup is available only on the server." 403
    request_body {
        max_size 25MB
    }
    reverse_proxy app:8000 {
        flush_interval -1
    }
}
