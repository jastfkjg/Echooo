# Start with .env.mock.example if you do not have model credentials.
DATABASE_URL=sqlite:///data/echooo.db
# For PostgreSQL, URL-encode credentials:
# DATABASE_URL=postgresql+psycopg://echooo:YOUR_PASSWORD@127.0.0.1:5433/echooo
APP_HOST=127.0.0.1
APP_PORT=8000
PUBLIC_ORIGIN=http://127.0.0.1:8000
# Set true behind public HTTPS; never expose an uninitialized workspace.
COOKIE_SECURE=false
LOG_LEVEL=INFO

STT_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_STREAMING_URL=wss://streaming.assemblyai.com/v3/ws
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
ASSEMBLYAI_SAMPLE_RATE=16000
ASSEMBLYAI_MODE=balanced
ASSEMBLYAI_MIN_TURN_SILENCE=160
ASSEMBLYAI_MAX_TURN_SILENCE=2400

# Streaming chat/completions endpoint with reliable JSON instruction following.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# browser: opt-in browser speech; cosyvoice: private preset-speaker server.
TTS_PROVIDER=browser
COSYVOICE_BASE_URL=http://127.0.0.1:50000
COSYVOICE_SAMPLE_RATE=24000
COSYVOICE_TIMEOUT_SECONDS=60
COSYVOICE_SPEAKER_ID=中文女

# Only used by the optional local PostgreSQL compose service.
# POSTGRES_PASSWORD=choose-a-development-password
