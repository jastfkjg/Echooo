# Realtime pipeline
STT_PROVIDER=assemblyai
LLM_PROVIDER=openai_compatible
TTS_PROVIDER=cosyvoice

APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# AssemblyAI Universal-3.5 Pro Realtime
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_STREAMING_URL=wss://streaming.assemblyai.com/v3/ws
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
ASSEMBLYAI_SAMPLE_RATE=16000
ASSEMBLYAI_MODE=balanced
ASSEMBLYAI_LANGUAGE_CODE=zh
ASSEMBLYAI_MIN_TURN_SILENCE=160
ASSEMBLYAI_MAX_TURN_SILENCE=2400

# Any OpenAI-compatible /chat/completions endpoint. API key may be empty for
# a trusted local server such as vLLM/Ollama with an OpenAI-compatible route.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=60

# Official CosyVoice FastAPI runtime, usually on a GPU machine.
COSYVOICE_BASE_URL=http://127.0.0.1:50000
COSYVOICE_MODE=zero_shot
COSYVOICE_SAMPLE_RATE=24000
COSYVOICE_TIMEOUT_SECONDS=60

# sft mode
COSYVOICE_SPEAKER=中文女
