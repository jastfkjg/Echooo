# Start with .env.mock.example if you do not have model credentials.
DATABASE_URL=sqlite:///data/echooo.db
# For PostgreSQL, URL-encode credentials:
# DATABASE_URL=postgresql+psycopg://echooo:YOUR_PASSWORD@127.0.0.1:5433/echooo
APP_HOST=127.0.0.1
APP_PORT=8000
PUBLIC_ORIGIN=http://127.0.0.1:8000
# Set true behind public HTTPS; never expose an uninitialized workspace.
COOKIE_SECURE=false
LOG_LEVEL=INFO

# Independent meeting participants; scripts/attendee.py configures these locally.
# See docs/ATTENDEE.md. No Recall subscription is used.
ATTENDEE_BASE_URL=
ATTENDEE_API_KEY=
ATTENDEE_CALLBACK_URL=
ATTENDEE_MAX_SECONDS=7200

STT_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_API_URL=https://api.assemblyai.com
ASSEMBLYAI_STREAMING_URL=wss://streaming.assemblyai.com/v3/ws
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
ASSEMBLYAI_SAMPLE_RATE=16000
ASSEMBLYAI_MODE=balanced
ASSEMBLYAI_MIN_TURN_SILENCE=160
ASSEMBLYAI_MAX_TURN_SILENCE=1000
ASSEMBLYAI_INTERRUPTION_DELAY=0
ASSEMBLYAI_LANGUAGE_CODES=zh,en
ASSEMBLYAI_KEYTERMS=Echooo,艾可
ASSEMBLYAI_PROMPT=

# Streaming chat/completions endpoint with reliable JSON instruction following.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# browser: device speech; cosyvoice: private server; dashscope: Alibaba Cloud CosyVoice.
TTS_PROVIDER=browser
COSYVOICE_BASE_URL=http://127.0.0.1:50000
COSYVOICE_SAMPLE_RATE=24000
COSYVOICE_TIMEOUT_SECONDS=60
COSYVOICE_SPEAKER_ID=中文女

# Set TTS_PROVIDER=dashscope after adding an API key from the matching region.
DASHSCOPE_API_KEY=
# Optional separate key for voice cloning/list/delete. Defaults to DASHSCOPE_API_KEY.
DASHSCOPE_VOICE_API_KEY=
# Beijing shared endpoint. A workspace-specific endpoint is also supported:
# wss://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_TTS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# Optional overrides for custom-voice management. The customization endpoint is
# derived from DASHSCOPE_TTS_URL when left blank.
DASHSCOPE_TTS_CUSTOMIZATION_URL=
DASHSCOPE_UPLOAD_URL=https://dashscope.aliyuncs.com/api/v1/uploads
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
# longanyang: Mandarin/English male; longanhuan: Mandarin/English female.
DASHSCOPE_TTS_VOICE=longanyang
# Optional comma-separated voice IDs created outside Echooo. Voices created in
# Voice options are queried from Alibaba Cloud automatically.
DASHSCOPE_TTS_CUSTOM_VOICES=
DASHSCOPE_TTS_SAMPLE_RATE=24000
# Connection setup / incoming-event idle timeout; not the spoken audio duration.
DASHSCOPE_TTS_TIMEOUT_SECONDS=60

# Only used by the optional local PostgreSQL compose service.
# POSTGRES_PASSWORD=choose-a-development-password
